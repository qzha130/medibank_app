# Paste into Streamlit Community Cloud Advanced settings > Secrets.
# Keep a real secrets.toml private; this example contains no credentials.
CHAT_PROVIDER = "gemini"
EMBEDDING_PROVIDER = "gemini"
GEMINI_CHAT_MODEL = "gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL = "gemini-embedding-001"
GEMINI_API_KEY = "replace-with-your-google-ai-studio-key"
PDF_DIRECTORY = "medibank_data"
CHROMA_DIRECTORY = "data/chroma"
