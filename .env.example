# Defaults for the UI. Both chat and embedding providers can be changed there.
CHAT_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google AI Studio / Gemini API. GOOGLE_API_KEY is also accepted as a fallback.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Relative paths resolve from the project folder.
PDF_DIRECTORY=medibank_data
CHROMA_DIRECTORY=data/chroma

# Local operation logs, review queue, and conservative cosine-distance guardrail.
LOG_DIRECTORY=data/logs
HANDOFF_DIRECTORY=data/handoffs
LOG_MAX_BYTES=2097152
LOG_BACKUP_COUNT=3
GUARDRAIL_MAX_DISTANCE=0.35
